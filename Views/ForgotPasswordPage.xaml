<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:KindHome.Views.Components"
             xmlns:vm="clr-namespace:KindHome.ViewModels"
             x:Class="KindHome.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Mot de passe oublié"
             SafeAreaEdges="All"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView x:Name="Scroller">
        <Grid x:Name="ContentGrid"
              RowDefinitions="Auto,*,Auto"
              Padding="20,0,20,8">

            <VerticalStackLayout Grid.Row="0">

                <!-- Fleche retour -->
                <ImageButton Source="icon_arrow_left.png"
                             Padding="10"
                             Margin="-6,0,0,0"
                             HorizontalOptions="Start"
                             Command="{Binding BackCommand}"
                             SemanticProperties.Description="Retour à la connexion" />

                <!-- Cercle avec cadenas -->
                <Border Style="{StaticResource FeatureIconCircle}"
                        Margin="0,28,0,0"
                        HorizontalOptions="Start">
                    <Image Source="icon_lock_key.png"
                           WidthRequest="38"
                           HeightRequest="38"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="Mot de passe oublié ?"
                       Style="{StaticResource Heading1}"
                       Margin="0,24,0,0" />
                <Label Text="Indiquez l'adresse e-mail de votre compte. Nous vous envoyons un lien pour choisir un nouveau mot de passe."
                       Style="{StaticResource Subtitle}"
                       Margin="0,8,0,0" />

                <components:FormField Margin="0,28,0,0"
                                      Title="Adresse e-mail"
                                      Placeholder="nom@exemple.com"
                                      Icon="icon_mail.png"
                                      ActiveIcon="icon_mail_green.png"
                                      Keyboard="Email"
                                      ReturnType="Send"
                                      Text="{Binding Email}"
                                      ErrorMessage="{Binding EmailError}"
                                      Completed="OnEmailCompleted" />

                <components:PrimaryButton Margin="0,20,0,0"
                                          Text="{Binding ButtonText}"
                                          IsBusy="{Binding IsBusy}"
                                          Command="{Binding SendCommand}" />

                <!-- Conseil (avant l'envoi) -->
                <Border Style="{StaticResource NoticeBoxBorder}"
                        Margin="0,20,0,0"
                        IsVisible="{Binding IsNotSent}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image Grid.Column="0"
                               Source="icon_info.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               VerticalOptions="Start"
                               Margin="0,1,0,0" />
                        <Label Grid.Column="1"
                               Text="Pensez à vérifier vos courriers indésirables si le message n'arrive pas."
                               Style="{StaticResource NoticeText}" />
                    </Grid>
                </Border>

                <!-- Succes (apres l'envoi) -->
                <Border Style="{StaticResource NoticeBoxBorder}"
                        Margin="0,20,0,0"
                        IsVisible="{Binding IsSent}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image Grid.Column="0"
                               Source="icon_check_circle.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               VerticalOptions="Start"
                               Margin="0,1,0,0" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Lien envoyé. Consultez votre boîte e-mail."
                                   Style="{StaticResource NoticeTitle}" />
                            <Label Text="Pensez à vérifier vos courriers indésirables si le message n'arrive pas."
                                   Style="{StaticResource NoticeText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Bas de page -->
            <Grid Grid.Row="2"
                  HeightRequest="44"
                  Padding="4,0"
                  HorizontalOptions="Center"
                  SemanticProperties.Description="Retour à la connexion">
                <Label Text="Retour à la connexion" Style="{StaticResource LinkTextBold}" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>
