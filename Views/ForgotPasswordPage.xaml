<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:KindHome.Views.Components"
             xmlns:vm="clr-namespace:KindHome.ViewModels"
             x:Class="KindHome.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Mot de passe oublié"
             SafeAreaEdges="All"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView x:Name="Scroller">
        <Grid x:Name="ContentGrid"
              RowDefinitions="Auto,*,Auto"
              Padding="20,0,20,8">

            <VerticalStackLayout Grid.Row="0">

                <!-- Fleche retour -->
                <ImageButton Source="icon_arrow_left.png"
                             Padding="10"
                             Margin="-6,0,0,0"
                             HorizontalOptions="Start"
                             Command="{Binding BackCommand}"
                             SemanticProperties.Description="Retour" />

                <!-- Cercle avec cadenas -->
                <Border Style="{StaticResource FeatureIconCircle}"
                        Margin="0,28,0,0"
                        HorizontalOptions="Start">
                    <Image Source="icon_lock_key.png"
                           WidthRequest="38"
                           HeightRequest="38"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="{Binding HeadingText}"
                       Style="{StaticResource Heading1}"
                       Margin="0,24,0,0" />
                <Label Text="{Binding SubtitleText}"
                       Style="{StaticResource Subtitle}"
                       Margin="0,8,0,0" />

                <!-- Etape 1 : e-mail et telephone -->
                <VerticalStackLayout IsVisible="{Binding IsStep1}">
                    <components:FormField x:Name="EmailField"
                                          Margin="0,28,0,0"
                                          Title="Adresse e-mail"
                                          Placeholder="nom@exemple.com"
                                          Icon="icon_mail.png"
                                          ActiveIcon="icon_mail_green.png"
                                          Keyboard="Email"
                                          ReturnType="Next"
                                          Text="{Binding Email}"
                                          ErrorMessage="{Binding EmailError}"
                                          Completed="OnEmailCompleted" />

                    <components:PhoneField x:Name="PhoneField"
                                           Margin="0,14,0,0"
                                           Title="Téléphone"
                                           Placeholder="6 XX XX XX XX"
                                           ReturnType="Send"
                                           Text="{Binding Phone}"
                                           ErrorMessage="{Binding PhoneError}"
                                           Completed="OnPhoneCompleted" />

                    <!-- Message d'erreur general -->
                    <Border Style="{StaticResource ErrorBannerBorder}"
                            Margin="0,20,0,0"
                            IsVisible="{Binding HasFormError}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Grid.Column="0"
                                   Source="icon_alert_circle.png"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   VerticalOptions="Start"
                                   Margin="0,1,0,0" />
                            <Label Grid.Column="1"
                                   Text="{Binding FormError}"
                                   Style="{StaticResource ErrorBannerText}" />
                        </Grid>
                    </Border>

                    <components:PrimaryButton Margin="0,20,0,0"
                                              Text="{Binding CheckButtonText}"
                                              IsBusy="{Binding IsBusy}"
                                              Command="{Binding CheckCommand}" />
                </VerticalStackLayout>

                <!-- Etape 2 : nouveau mot de passe -->
                <VerticalStackLayout IsVisible="{Binding IsStep2}">
                    <components:FormField x:Name="NewPasswordField"
                                          Margin="0,28,0,0"
                                          Title="Nouveau mot de passe"
                                          Placeholder="Créez un mot de passe"
                                          HelperText="8 caractères minimum, dont un chiffre."
                                          IsPassword="True"
                                          ReturnType="Next"
                                          Text="{Binding NewPassword}"
                                          ErrorMessage="{Binding NewPasswordError}"
                                          Completed="OnNewPasswordCompleted" />

                    <components:FormField x:Name="ConfirmField"
                                          Margin="0,14,0,0"
                                          Title="Confirmer le mot de passe"
                                          Placeholder="Confirmer le mot de passe"
                                          IsPassword="True"
                                          ReturnType="Done"
                                          Text="{Binding ConfirmPassword}"
                                          ErrorMessage="{Binding ConfirmError}"
                                          Completed="OnConfirmCompleted" />

                    <!-- Message d'erreur general -->
                    <Border Style="{StaticResource ErrorBannerBorder}"
                            Margin="0,20,0,0"
                            IsVisible="{Binding HasFormError}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Grid.Column="0"
                                   Source="icon_alert_circle.png"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   VerticalOptions="Start"
                                   Margin="0,1,0,0" />
                            <Label Grid.Column="1"
                                   Text="{Binding FormError}"
                                   Style="{StaticResource ErrorBannerText}" />
                        </Grid>
                    </Border>

                    <components:PrimaryButton Margin="0,20,0,0"
                                              Text="{Binding ResetButtonText}"
                                              IsBusy="{Binding IsBusy}"
                                              Command="{Binding ResetCommand}" />
                </VerticalStackLayout>

                <!-- Etape 3 : mot de passe modifie -->
                <VerticalStackLayout IsVisible="{Binding IsDone}">
                    <Border Style="{StaticResource NoticeBoxBorder}"
                            Margin="0,28,0,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image Grid.Column="0"
                                   Source="icon_check_circle.png"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   VerticalOptions="Start"
                                   Margin="0,1,0,0" />
                            <Label Grid.Column="1"
                                   Text="Votre mot de passe a été modifié."
                                   Style="{StaticResource NoticeTitle}" />
                        </Grid>
                    </Border>

                    <components:PrimaryButton Margin="0,20,0,0"
                                              Text="Se connecter"
                                              Command="{Binding GoToLoginCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Bas de page -->
            <Grid Grid.Row="2"
                  HeightRequest="44"
                  Padding="4,0"
                  HorizontalOptions="Center"
                  IsVisible="{Binding ShowFooterLink}"
                  SemanticProperties.Description="Retour à la connexion">
                <Label Text="Retour à la connexion" Style="{StaticResource LinkTextBold}" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LoginLinkCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>
