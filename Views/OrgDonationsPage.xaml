<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:KindHome.Views.Components"
             xmlns:models="clr-namespace:KindHome.Models"
             xmlns:vm="clr-namespace:KindHome.ViewModels"
             x:Class="KindHome.Views.OrgDonationsPage"
             x:DataType="vm:OrgDonationsViewModel"
             Title="Dons reçus"
             SafeAreaEdges="None"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">    <Grid RowDefinitions="*,Auto" SafeAreaEdges="None">

        <Grid Grid.Row="0"
              RowDefinitions="Auto,*"
              SafeAreaEdges="Container,Container,Container,None">
            <Label Grid.Row="0"
                   Text="Dons reçus"
                   Style="{StaticResource TopBarTitle}"
                   HeightRequest="44"
                   Margin="20,0" />
            <ScrollView Grid.Row="1" IsVisible="{Binding HasItems}">
                <VerticalStackLayout Padding="20,12,20,16"
                                     Spacing="12"
                                     BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrgDonationItem">
                            <Grid>
                                <Border Style="{StaticResource CardBorder}" />
                                <VerticalStackLayout Padding="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 14"
                                                StrokeThickness="0"
                                                WidthRequest="52"
                                                HeightRequest="56"
                                                VerticalOptions="Center">
                                            <Image Source="{Binding Need.Photo}" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{Binding Donor}"
                                                   Style="{StaticResource CardSubtitle}"
                                                   Margin="0,2,0,0" />
                                            <Label Text="{Binding Date}"
                                                   Style="{StaticResource CardSubtitle}"
                                                   Margin="0,2,0,0" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                Style="{StaticResource TagBorder}"
                                                VerticalOptions="Start">
                                            <Label Text="{Binding Status}" Style="{StaticResource TagLabel}" />
                                        </Border>
                                    </Grid>
                                    <components:PrimaryButton Text="Confirmer la remise"
                                                              Compact="True"
                                                              Margin="0,12,0,0"
                                                              IsVisible="{Binding NeedsConfirmation}"
                                                              CommandParameter="{Binding .}"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OrgDonationsViewModel}}, Path=ConfirmCommand}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <components:EmptyState Grid.Row="1"
                                   VerticalOptions="Center"
                                   Icon="icon_gift_empty.png"
                                   Title="Aucun don pour l'instant"
                                   Message="Les dons proposés par les donateurs apparaîtront ici."
                                   IsVisible="{Binding IsEmpty}" />
        </Grid>

        <components:OrgTabBar Grid.Row="1" ActiveTab="Donations" />
    </Grid>
</ContentPage>