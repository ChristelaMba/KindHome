<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:KindHome.Views.Components"
             xmlns:vm="clr-namespace:KindHome.ViewModels"
             x:Class="KindHome.Views.DonationPage"
             x:DataType="vm:DonationViewModel"
             Title="Proposer un don"
             SafeAreaEdges="All"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Barre du haut -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="4"
              Padding="14,0,20,0">
            <ImageButton Grid.Column="0"
                         Source="icon_arrow_left.png"
                         Padding="10"
                         Command="{Binding BackCommand}"
                         SemanticProperties.Description="Retour" />
            <Label Grid.Column="1"
                   Text="Proposer un don"
                   Style="{StaticResource TopBarTitle}" />
        </Grid>

        <!-- Contenu : defile (par exemple quand le clavier est ouvert) -->
        <ScrollView Grid.Row="1">
            <Grid Padding="20,12,20,20">

                <!-- Formulaire -->
                <VerticalStackLayout IsVisible="{Binding ShowForm}">

                    <!-- Carte du besoin choisi -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    Style="{StaticResource IconTileBorder}"
                                    VerticalOptions="Center">
                                <Image Source="icon_archive.png"
                                       WidthRequest="30"
                                       HeightRequest="30"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Need.Title}" Style="{StaticResource SectionTitle}" />
                                <Label Text="{Binding OrphanageLine}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                                <components:NeedProgressBar Progress="{Binding Need.Progress}"
                                                            Size="Medium"
                                                            Margin="0,8,0,0" />
                                <Label Text="{Binding Need.ProgressText}"
                                       Style="{StaticResource CaptionSmall}"
                                       Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Type de don -->
                    <Label Text="Type de don"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,18,0,4" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <components:ChoiceChip Grid.Column="0"
                                               Text="En nature"
                                               IsSelected="{Binding IsInKind}"
                                               Command="{Binding SelectInKindCommand}" />
                        <components:ChoiceChip Grid.Column="1"
                                               Text="Financier"
                                               IsSelected="{Binding IsFinancial}"
                                               Command="{Binding SelectFinancialCommand}" />
                    </Grid>

                    <!-- Quantite (don en nature) -->
                    <VerticalStackLayout Margin="0,18,0,0" IsVisible="{Binding IsInKind}">
                        <Label Text="Quantité"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,4" />
                        <Grid ColumnDefinitions="Auto,56,Auto,*" ColumnSpacing="12">
                            <components:QuantityButton Grid.Column="0"
                                                       IsEnabled="{Binding CanDecrease}"
                                                       Command="{Binding DecreaseCommand}"
                                                       SemanticProperties.Description="Diminuer la quantité" />
                            <Label Grid.Column="1"
                                   Text="{Binding Quantity}"
                                   Style="{StaticResource QuantityValue}"
                                   VerticalOptions="Center" />
                            <components:QuantityButton Grid.Column="2"
                                                       IsPlus="True"
                                                       IsEnabled="{Binding CanIncrease}"
                                                       Command="{Binding IncreaseCommand}"
                                                       SemanticProperties.Description="Augmenter la quantité" />
                            <Label Grid.Column="3"
                                   Text="{Binding QuantityUnitText}"
                                   Style="{StaticResource Caption}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Montant (don financier) -->
                    <components:FormField Margin="0,18,0,0"
                                          IsVisible="{Binding IsFinancial}"
                                          Title="Montant (FCFA)"
                                          Placeholder="Ex : 10 000"
                                          Keyboard="Numeric"
                                          Text="{Binding AmountText}"
                                          ErrorMessage="{Binding AmountError}" />

                    <!-- Remise du don -->
                    <Label Text="Remise du don"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,18,0,4" />
                    <VerticalStackLayout Spacing="8">
                        <components:RadioOption Text="Je dépose sur place"
                                                IsSelected="{Binding OnSiteDelivery}"
                                                Command="{Binding SelectOnSiteCommand}" />
                        <components:RadioOption Text="L'orphelinat vient récupérer"
                                                IsSelected="{Binding IsPickup}"
                                                Command="{Binding SelectPickupCommand}" />
                    </VerticalStackLayout>

                    <!-- Date souhaitee -->
                    <components:DateField Margin="0,18,0,0"
                                          Title="Date souhaitée"
                                          Date="{Binding DateValue}"
                                          ErrorMessage="{Binding DateError}" />

                    <!-- Message -->
                    <components:TextArea Margin="0,18,0,0"
                                         Title="Message (facultatif)"
                                         Placeholder="Un mot pour l'équipe"
                                         MaxLength="300"
                                         HasShadow="False"
                                         Text="{Binding Message}" />
                </VerticalStackLayout>

                <!-- Echec de l'envoi : bandeau, recapitulatif et bouton Reessayer l'envoi -->
                <VerticalStackLayout Spacing="14"
                                     Margin="0,2,0,0"
                                     IsVisible="{Binding ShowFailure}">
                    <Border Style="{StaticResource ErrorBannerBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Grid.Column="0"
                                   Source="icon_alert_circle.png"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   VerticalOptions="Start"
                                   Margin="0,1,0,0" />
                            <Label Grid.Column="1"
                                   Text="Votre don n'a pas pu être envoyé. Vos informations sont conservées."
                                   Style="{StaticResource ErrorBannerText}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout>
                            <Label Text="{Binding Donation.RecapTitle}" Style="{StaticResource SectionTitle}" />
                            <Label Text="{Binding Donation.RecapSubtitle}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,2,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <!-- Bouton du bas, fixe -->
        <Grid Grid.Row="2" Padding="20,8,20,20">
            <components:PrimaryButton Text="{Binding ButtonText}"
                                      IsBusy="{Binding IsBusy}"
                                      Command="{Binding SubmitCommand}" />
        </Grid>
    </Grid>
</ContentPage>
