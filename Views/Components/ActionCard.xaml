<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:KindHome.Views.Components"
             x:Class="KindHome.Views.Components.ActionCard"
             x:DataType="components:ActionCard"
             x:Name="Root">
    <!-- Carte d'action : icone en haut, texte en dessous -->
    <Border Style="{StaticResource ActionCardBorder}">
        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
            <Image Source="{Binding Icon, Source={x:Reference Root}}"
                   WidthRequest="24"
                   HeightRequest="24"
                   HorizontalOptions="Center" />
            <Label Text="{Binding Text, Source={x:Reference Root}}"
                   Style="{StaticResource ActionCardLabel}" />
        </VerticalStackLayout>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>