<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:KindHome.Views.Components"
             x:Class="KindHome.Views.Components.EmptyState"
             x:DataType="components:EmptyState"
             x:Name="Root">
    <!-- Vue d'etat vide : cercle avec icone, titre, texte et bouton -->
    <VerticalStackLayout Spacing="12"
                         Padding="12,0"
                         HorizontalOptions="Center">
        <Border x:Name="Circle"
                Style="{StaticResource StateIconCircle}"
                HorizontalOptions="Center">
            <Image x:Name="IconImage"
                   WidthRequest="44"
                   HeightRequest="44"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>
        <Label Text="{Binding Title, Source={x:Reference Root}}"
               Style="{StaticResource StateTitle}" />
        <Label Text="{Binding Message, Source={x:Reference Root}}"
               Style="{StaticResource StateText}" />
        <components:PrimaryButton x:Name="ActionButton"
                                  Text="{Binding ButtonText, Source={x:Reference Root}}"
                                  Compact="True"
                                  Margin="0,8,0,0"
                                  HorizontalOptions="Center"
                                  Clicked="OnActionClicked" />
        <components:SecondaryButton x:Name="SecondaryActionButton"
                                    Text="{Binding ButtonText, Source={x:Reference Root}}"
                                    Compact="True"
                                    Margin="0,8,0,0"
                                    HorizontalOptions="Center"
                                    IsVisible="False"
                                    Clicked="OnActionClicked" />
    </VerticalStackLayout>
</ContentView>
