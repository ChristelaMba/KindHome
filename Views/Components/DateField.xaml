<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KindHome.Views.Components.DateField">
    <VerticalStackLayout>

        <!-- Libelle au-dessus du champ -->
        <Label x:Name="TitleLabel"
               Style="{StaticResource FieldLabel}"
               Margin="0,0,0,4"
               IsVisible="False" />

        <!-- Champ : icone de calendrier et date. Le selecteur natif est place par-dessus, invisible, pour recevoir l'appui. -->
        <Border x:Name="Box" Style="{StaticResource FieldBorder}">
            <Grid x:Name="Host"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="10"
                  SizeChanged="OnHostSizeChanged">
                <Image Grid.Column="0"
                       Source="icon_calendar.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       VerticalOptions="Center" />
                <Label x:Name="ValueLabel"
                       Grid.Column="1"
                       Style="{StaticResource FieldPlaceholderText}" />
                <DatePicker x:Name="Picker"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Opacity="0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Focused="OnPickerFocused"
                            DateSelected="OnDateSelected" />
            </Grid>
        </Border>

        <!-- Message d'erreur sous le champ -->
        <Label x:Name="MessageLabel"
               Style="{StaticResource ErrorText}"
               Margin="18,4,0,0"
               IsVisible="False" />

    </VerticalStackLayout>
</ContentView>
