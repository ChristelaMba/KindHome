<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KindHome.Views.Components.PickerField">
    <VerticalStackLayout>

        <!-- Libelle au-dessus du champ -->
        <Label x:Name="TitleLabel"
               Style="{StaticResource FieldLabel}"
               Margin="0,0,0,6"
               IsVisible="False" />

        <!-- Champ : valeur et fleche. Le selecteur natif est place par-dessus, invisible, pour recevoir l'appui. -->
        <Border x:Name="Box" Style="{StaticResource FieldBorder}">
            <Grid x:Name="Host"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  SizeChanged="OnHostSizeChanged">
                <Label x:Name="ValueLabel"
                       Grid.Column="0"
                       Style="{StaticResource FieldValueText}" />
                <Image Grid.Column="1"
                       Source="icon_chevron_down.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       VerticalOptions="Center" />
                <Picker x:Name="Selector"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Opacity="0"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        SelectedIndexChanged="OnSelectedIndexChanged" />
            </Grid>
        </Border>

    </VerticalStackLayout>
</ContentView>