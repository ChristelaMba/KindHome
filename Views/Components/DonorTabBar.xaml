<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KindHome.Views.Components.DonorTabBar">
    <!-- Le fond passe sous la barre de navigation d'Android (SafeAreaEdges) ; les onglets restent au-dessus -->
    <Border Style="{StaticResource TabBarBorder}"
            SafeAreaEdges="Container">
        <Grid ColumnDefinitions="*,*,*,*"
              HeightRequest="84"
              Padding="{StaticResource TabBarPadding}">

            <VerticalStackLayout x:Name="HomeTab" Grid.Column="0" Spacing="4" VerticalOptions="Center"
                                 SemanticProperties.Description="Accueil">
                <Image x:Name="HomeIcon" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                <Label x:Name="HomeLabel" Text="Accueil" Style="{StaticResource TabLabel}" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="MapTab" Grid.Column="1" Spacing="4" VerticalOptions="Center"
                                 SemanticProperties.Description="Carte">
                <Image x:Name="MapIcon" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                <Label x:Name="MapLabel" Text="Carte" Style="{StaticResource TabLabel}" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMapTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="NeedsTab" Grid.Column="2" Spacing="4" VerticalOptions="Center"
                                 SemanticProperties.Description="Besoins">
                <Image x:Name="NeedsIcon" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                <Label x:Name="NeedsLabel" Text="Besoins" Style="{StaticResource TabLabel}" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNeedsTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ProfileTab" Grid.Column="3" Spacing="4" VerticalOptions="Center"
                                 SemanticProperties.Description="Profil">
                <Image x:Name="ProfileIcon" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                <Label x:Name="ProfileLabel" Text="Profil" Style="{StaticResource TabLabel}" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
