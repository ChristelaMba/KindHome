    <!-- Cadre d'un champ : hauteur 52, coins 26, contour 1.5, fond blanc casse, ombre 0 4 12 vert a 6%.
         Etats (groupe FieldStates) : Normal, Active, Disabled, Error. -->
    <Style TargetType="Border" x:Key="FieldBorder">
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="26" />
        </Setter>
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke" Value="{StaticResource BorderField}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceWhite}" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,4" Radius="12" Opacity="0.06" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="FieldStates">
                    <VisualState x:Name="Normal" />
                    <!-- Valide : contour vert 1.5 (champ correct, avec la coche a droite) -->
                    <VisualState x:Name="Valid">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{StaticResource GreenGradientStart}" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Actif : contour 2 vert, avec l'anneau FieldRing autour -->
                    <VisualState x:Name="Active">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{StaticResource PrimaryGreen}" />
                            <Setter Property="StrokeThickness" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{StaticResource BorderDisabled}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource DisabledFieldBackground}" />
                            <Setter Property="Shadow">
                                <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,4" Radius="12" Opacity="0" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Error">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{StaticResource ErrorRed}" />
                            <Setter Property="Shadow">
                                <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,4" Radius="12" Opacity="0" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Anneau de focus autour d'un champ : 4 de large, #D3E6DB, visible seulement a l'etat Active. Il deborde du champ (marge -4). -->
    <Style TargetType="Border" x:Key="FieldRing">
