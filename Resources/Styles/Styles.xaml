        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <!-- ===== Pages Mon historique, Reglages, Notifications ===== -->
    <!-- Interrupteur aux couleurs du projet -->
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource PrimaryGreen}" />
    </Style>

    <!-- Point vert d'une notification non lue : 10, rond -->
    <Style TargetType="Border" x:Key="UnreadDot">
        <Setter Property="WidthRequest" Value="10" />
        <Setter Property="HeightRequest" Value="10" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="5" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryGreen}" />
    </Style>
    <!-- Bloc d'information (conseil, prochaine etape, succes) : coins 20, fond vert clair, marge 16 / 14 -->
    <Style TargetType="Border" x:Key="NoticeBoxBorder">
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="20" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SoftGreenBackground}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- Encadre d'information (Mon impact, Prochaine etape) : fond vert clair, sans ombre -->
    <Style TargetType="Border" x:Key="InfoBoxBorder">
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="22" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SoftGreenBackground}" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <!-- Message d'erreur en haut d'un formulaire : coins 20, contour rouge 1.5, fond rose -->
    <Style TargetType="Border" x:Key="ErrorBannerBorder">
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="20" />
        </Setter>
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke" Value="{StaticResource ErrorRed}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorBackground}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- Bandeau Liste / Carte : hauteur 52, coins 26, padding 4, fond blanc casse a 85%, contour blanc a 80%, ombre 0 8 20 vert a 12% -->
    <Style TargetType="Border" x:Key="SegmentedBorder">
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="26" />
        </Setter>
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{StaticResource GlassBorder80}" />
        <Setter Property="BackgroundColor" Value="{StaticResource GlassSurface85}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,8" Radius="20" Opacity="0.12" />
        </Setter>
    </Style>

    <!-- Feuille de la liste de l'annuaire : coins hauts 24, fond blanc casse, ombre 0 -8 20 vert a 8% -->
    <Style TargetType="Border" x:Key="ListSheetBorder">
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="24,24,0,0" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceWhite}" />
        <Setter Property="Padding" Value="20,8,20,0" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,-8" Radius="20" Opacity="0.08" />
        </Setter>
    </Style>

    <!-- Panneau blanc cassé sous la photo (fiche et detail du besoin) : coins hauts 28, fond de page -->
    <Style TargetType="Border" x:Key="PhotoSheetBorder">
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="28,28,0,0" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
    </Style>

    <!-- ===== Puces d'information (non cliquables) ===== -->
    <!-- Etiquette de categorie : hauteur 32, coins 16, fond vert tres clair, texte 13 moyen -->
    <Style TargetType="Border" x:Key="TagBorder">
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="16" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource TagBackground}" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style TargetType="Label" x:Key="TagLabel">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Pastille de lieu : hauteur 34, coins 17, texte 13 semi-gras -->
    <Style TargetType="Border" x:Key="LocationPillBorder" BasedOn="{StaticResource TagBorder}">
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="17" />
        </Setter>
    </Style>

    <Style TargetType="Label" x:Key="LocationPillLabel" BasedOn="{StaticResource TagLabel}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
    </Style>

    <!-- Badge sur photo ("Besoin en cours") : hauteur 28, coins 14, fond blanc a 22%, contour blanc a 40%, texte 12 semi-gras blanc -->
    <Style TargetType="Border" x:Key="PhotoBadgeBorder">
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="14" />
        </Setter>
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{StaticResource WhiteBadgeBorder}" />
        <Setter Property="BackgroundColor" Value="{StaticResource WhiteBadgeBackground}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style TargetType="Label" x:Key="PhotoBadgeLabel">
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Points de la page d'accueil (onboarding) : actif 20 x 6 blanc, inactif 6 x 6 blanc a 45% -->
    <Style TargetType="Border" x:Key="PageDotActive">
        <Setter Property="WidthRequest" Value="20" />
        <Setter Property="HeightRequest" Value="6" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="3" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
    </Style>

    <Style TargetType="Border" x:Key="PageDot" BasedOn="{StaticResource PageDotActive}">
        <Setter Property="WidthRequest" Value="6" />
        <Setter Property="BackgroundColor" Value="{StaticResource WhiteDotInactive}" />
    </Style>

    <!-- ===== Barres de progression (dessinees avec deux Border : fond + remplissage) ===== -->
    <!-- Liste : 6 / coins 3. Proposer un don : 8 / coins 4. Detail du besoin : 10 / coins 5 avec degrade -->
    <Style TargetType="Border" x:Key="ProgressTrackSmall">
        <Setter Property="HeightRequest" Value="6" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="3" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource ProgressTrack}" />
    </Style>

    <Style TargetType="Border" x:Key="ProgressTrackMedium" BasedOn="{StaticResource ProgressTrackSmall}">
        <Setter Property="HeightRequest" Value="8" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="ProgressTrackLarge" BasedOn="{StaticResource ProgressTrackSmall}">
        <Setter Property="HeightRequest" Value="10" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="5" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="ProgressFillSmall">
        <Setter Property="HeightRequest" Value="6" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="3" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryGreen}" />
    </Style>

    <Style TargetType="Border" x:Key="ProgressFillMedium" BasedOn="{StaticResource ProgressFillSmall}">
        <Setter Property="HeightRequest" Value="8" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="ProgressFillLarge" BasedOn="{StaticResource ProgressFillSmall}">
        <Setter Property="HeightRequest" Value="10" />
        <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="5" />
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource PrimaryGreen}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ProgressTrack}" />
    </Style>

    <!-- ===== Icones dans des tuiles ou cercles ===== -->
    <!-- Tuile d'icone : 64 x 64 (don), coins 16, fond vert pale ; version 52 x 56 coins 14 dans l'espace organisation -->
    <Style TargetType="Border" x:Key="IconTileBorder">
        <Setter Property="WidthRequest" Value="64" />
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="16" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource IconTileBackground}" />
    </Style>

    <Style TargetType="Border" x:Key="IconTileSmallBorder" BasedOn="{StaticResource IconTileBorder}">
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="14" />
        </Setter>
    </Style>

    <!-- Cercle d'icone de la page Mot de passe oublie : 84, fond vert tres clair, ombre 0 8 20 vert a 12% -->
    <Style TargetType="Border" x:Key="FeatureIconCircle">
        <Setter Property="WidthRequest" Value="84" />
        <Setter Property="HeightRequest" Value="84" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="42" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource TagBackground}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,8" Radius="20" Opacity="0.12" />
        </Setter>
    </Style>

    <!-- Cercle d'icone des etats vides : 96, fond vert tres clair, ombre 0 8 20 vert a 12% -->
    <Style TargetType="Border" x:Key="StateIconCircle">
        <Setter Property="WidthRequest" Value="96" />
        <Setter Property="HeightRequest" Value="96" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="48" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource TagBackground}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,8" Radius="20" Opacity="0.12" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="StateIconCircleError" BasedOn="{StaticResource StateIconCircle}">
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorBackground}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowRedBrush}" Offset="0,8" Radius="20" Opacity="0.12" />
        </Setter>
    </Style>

    <!-- Cercle de succes : exterieur 112 (fond vert tres clair), interieur 80 (degrade diagonal, ombre 0 10 22 vert a 30%) -->
    <Style TargetType="Border" x:Key="SuccessCircleOuter">
        <Setter Property="WidthRequest" Value="112" />
        <Setter Property="HeightRequest" Value="112" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="56" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource TagBackground}" />
    </Style>

    <Style TargetType="Border" x:Key="SuccessCircleInner">
        <Setter Property="WidthRequest" Value="80" />
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="40" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource PrimaryGradientDiagonalBrush}" />
    </Style>

    <!-- Ombre du cercle de succes (0 10 22 vert a 30%) dessinee avec un degrade radial : l'ombre native d'Android est carree sur un Border arrondi -->
    <Style TargetType="Ellipse" x:Key="SuccessCircleShadow">
        <Setter Property="WidthRequest" Value="108" />
        <Setter Property="HeightRequest" Value="108" />
        <Setter Property="TranslationY" Value="10" />
        <Setter Property="Opacity" Value="0.3" />
        <Setter Property="Fill">
            <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                <GradientStop Color="{StaticResource ShadowGreen}" Offset="0.62" />
                <GradientStop Color="Transparent" Offset="1.0" />
            </RadialGradientBrush>
        </Setter>
    </Style>
    <!-- Avatar de l'accueil : 40, anneau blanc casse 2 (le contour est dessine par la Border) ; avatar du profil : 104, anneau 4 -->
    <Style TargetType="Border" x:Key="AvatarSmall">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="22" />
        </Setter>
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{StaticResource SurfaceWhite}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,4" Radius="10" Opacity="0.18" />
        </Setter>
    </Style>

    <!-- Avatar sans photo : meme style, fond vert tres clair et initiale -->
    <Style TargetType="Border" x:Key="AvatarInitialCircle" BasedOn="{StaticResource AvatarSmall}">
        <Setter Property="BackgroundColor" Value="{StaticResource TagBackground}" />
    </Style>

    <Style TargetType="Label" x:Key="AvatarInitial">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Grand avatar du profil : photo de 104 + anneau de 4 = 112 -->
    <Style TargetType="Border" x:Key="AvatarLarge">
        <Setter Property="WidthRequest" Value="112" />
        <Setter Property="HeightRequest" Value="112" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="56" />
        </Setter>
        <Setter Property="StrokeThickness" Value="4" />
        <Setter Property="Stroke" Value="{StaticResource SurfaceWhite}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,10" Radius="24" Opacity="0.18" />
        </Setter>
    </Style>

    <!-- Grand avatar sans photo : meme style, fond vert tres clair et grande initiale -->
    <Style TargetType="Border" x:Key="AvatarLargeInitialCircle" BasedOn="{StaticResource AvatarLarge}">
        <Setter Property="BackgroundColor" Value="{StaticResource TagBackground}" />
    </Style>

    <Style TargetType="Label" x:Key="AvatarInitialLarge">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Logo de l'organisation : 56 x 56 rond, fond blanc casse, ombre 0 6 16 vert a 14% -->
    <Style TargetType="Border" x:Key="OrganizationLogoCircle">
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="28" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceWhite}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,6" Radius="16" Opacity="0.14" />
        </Setter>
    </Style>

    <!-- Ombre douce d'un petit rond blanc (0 4 12 vert a 12%) dessinee avec un degrade radial : l'ombre native d'Android est carree sur un Border arrondi -->
    <Style TargetType="Ellipse" x:Key="SoftCircleShadow">
        <Setter Property="TranslationY" Value="4" />
        <Setter Property="Opacity" Value="0.12" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Fill">
            <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                <GradientStop Color="{StaticResource ShadowGreen}" Offset="0.7" />
                <GradientStop Color="Transparent" Offset="1.0" />
            </RadialGradientBrush>
        </Setter>
    </Style>
    <!-- Rond de la boite sur le detail du besoin : 44, fond blanc casse, ombre 0 4 12 vert a 12% -->
    <Style TargetType="Border" x:Key="NeedStatCircle">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="22" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceWhite}" />
    </Style>

    <!-- Bouton de position sur la carte : 44, rond, fond blanc casse a 92%, contour blanc a 80%, ombre 0 6 14 vert a 14% -->
    <Style TargetType="Border" x:Key="MapLocateButtonBorder">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="22" />
        </Setter>
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{StaticResource GlassBorder80}" />
        <Setter Property="BackgroundColor" Value="{StaticResource GlassSurface92}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,6" Radius="14" Opacity="0.14" />
        </Setter>
    </Style>

    <!-- ===== Chargement : blocs gris simples, sans animation ===== -->
    <Style TargetType="Border" x:Key="SkeletonBlock">
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="16" />
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SkeletonGray}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource PrimaryGreen}" />
    </Style>

    <!-- ===== Separateurs ===== -->
    <Style TargetType="BoxView" x:Key="DividerLine">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource DividerList}" />
    </Style>

    <!-- Traits de chaque cote du mot "ou" : 1 de haut, #DCE3DD -->
    <Style TargetType="BoxView" x:Key="DividerOr">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource BorderDisabled}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Separateur vertical entre les chiffres de la vue d'ensemble : 1 de large, #C9D8CF -->
    <Style TargetType="BoxView" x:Key="DividerStatLine">
        <Setter Property="WidthRequest" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource DividerStat}" />
    </Style>

    <Style TargetType="BoxView" x:Key="DividerVertical">
        <Setter Property="WidthRequest" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource BorderDisabled}" />
    </Style>

</ResourceDictionary>
