<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Valeurs releves dans la maquette HTML (cadre 390 x 844, 1 unite CSS = 1 unite MAUI). -->

    <!-- ===== Polices : Inter. Les alias seront declares dans MauiProgram quand les fichiers seront dans Resources/Fonts ===== -->
    <x:String x:Key="FontRegular">InterRegular</x:String>
    <x:String x:Key="FontMedium">InterMedium</x:String>
    <x:String x:Key="FontSemiBold">InterSemiBold</x:String>
    <x:String x:Key="FontBold">InterBold</x:String>

    <!-- ===== Marges des champs et de la barre d'onglets ===== -->
    <Thickness x:Key="FieldPadding">18,0</Thickness>
    <Thickness x:Key="FieldPaddingWithButton">18,0,6,0</Thickness>
    <Thickness x:Key="FieldPaddingWithIcon">18,0,16,0</Thickness>
    <Thickness x:Key="TabBarPadding">12,8,12,20</Thickness>
    <Thickness x:Key="TabBarPaddingOrganization">8,8,8,20</Thickness>

    <!-- ===== Page, Shell ===== -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource PageBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource GlassSurface90}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- ===== Textes ===== -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- LineHeight MAUI = hauteur de ligne CSS / taille de police -->
    <Style TargetType="Label" x:Key="OnboardingTitle">
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <Style TargetType="Label" x:Key="OnboardingText">
        <Setter Property="TextColor" Value="{StaticResource TextOnDarkSoft}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <Style TargetType="Label" x:Key="BrandName">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="1.153846" />
        <Setter Property="CharacterSpacing" Value="-0.2" />
    </Style>

    <!-- Logo sur fond sombre (onboarding) : texte blanc, slogan a 92% -->
    <Style TargetType="Label" x:Key="BrandNameOnDark" BasedOn="{StaticResource BrandName}">
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
    </Style>

    <Style TargetType="Label" x:Key="BrandTaglineOnDark">
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.384615" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style TargetType="Label" x:Key="BrandTagline">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="Label" x:Key="Heading1">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="1.230769" />
    </Style>

    <Style TargetType="Label" x:Key="Heading2">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <Style TargetType="Label" x:Key="TopBarTitle">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="1.272727" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="TopBarTitleSmall">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="OrganizationName">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="1.333333" />
    </Style>

    <Style TargetType="Label" x:Key="SectionTitle">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Label" x:Key="FieldLabel">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" x:Key="Subtitle">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.466667" />
    </Style>

    <Style TargetType="Label" x:Key="BodyText">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.571429" />
    </Style>

    <!-- Role sous le nom du profil : 14. Lieu : 13, vert -->
    <Style TargetType="Label" x:Key="ProfileRole">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="LocationGreen">
        <Setter Property="TextColor" Value="{StaticResource PrimaryGreen}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Texte de l'encadre "Mon impact" : 14 / 21, #3C554B -->
    <Style TargetType="Label" x:Key="ImpactText">
        <Setter Property="TextColor" Value="{StaticResource TextSoft}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.5" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Morceaux du texte "Mon impact" : sans police explicite, Android prend la police du systeme -->
    <Style TargetType="Span" x:Key="ImpactSpan">
        <Setter Property="TextColor" Value="{StaticResource TextSoft}" />
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Span" x:Key="ImpactSpanBold" BasedOn="{StaticResource ImpactSpan}">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
    </Style>

    <!-- "Vue d'ensemble" : 15 semi-gras -->
    <Style TargetType="Label" x:Key="OverviewTitle">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- "Bonjour," de l'accueil : 14 / 18 -->
    <Style TargetType="Label" x:Key="GreetingSmall">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.285714" />
    </Style>

    <!-- Texte du champ de recherche (non modifiable) : 15, gris du texte d'aide -->
    <Style TargetType="Label" x:Key="SearchPlaceholder">
        <Setter Property="TextColor" Value="{StaticResource PlaceholderGray}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Textes de la grande carte "Besoin en cours" : nom 20 / 26 semi-gras, lignes 13, tout en blanc -->
    <Style TargetType="Label" x:Key="FeaturedTitle">
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style TargetType="Label" x:Key="FeaturedMeta">
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Nom de la ville sur la carte dessinee : 14 semi-gras, #3C554B -->
    <Style TargetType="Label" x:Key="MapLabel">
        <Setter Property="TextColor" Value="{StaticResource TextSoft}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Valeur en gras d'une ligne d'information (32 enfants, 4,6) : 14 semi-gras -->
    <Style TargetType="Label" x:Key="InfoBold">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- "Structure verifiee" : 13 semi-gras, vert -->
    <Style TargetType="Label" x:Key="VerifiedLabel">
        <Setter Property="TextColor" Value="{StaticResource PrimaryGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Onglets de la fiche (A propos, Besoins, Actualites) : 14, normal en moyen gris, actif en semi-gras vert fonce -->
    <Style TargetType="Label" x:Key="DetailTab">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="DetailTabActive" BasedOn="{StaticResource DetailTab}">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
    </Style>

    <!-- Selecteur Liste / Carte : bouton dans le bandeau, hauteur libre (44), coins 22, texte 14 -->
    <Style TargetType="Button" x:Key="SegmentButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Button" x:Key="SegmentButtonSelected" BasedOn="{StaticResource SegmentButton}">
        <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
    </Style>

    <!-- Sous-titre 14 / 20 (page Inscription) -->
    <Style TargetType="Label" x:Key="SubtitleSmall">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.428571" />
    </Style>

    <!-- Texte des encadres d'information : 14 / 20, vert fonce ; version titre en semi-gras -->
    <Style TargetType="Label" x:Key="NoticeText">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.428571" />
    </Style>

    <Style TargetType="Label" x:Key="NoticeTitle" BasedOn="{StaticResource NoticeText}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
    </Style>

    <!-- Prefixe fixe du champ telephone ("+237") : 16 semi-gras -->
    <Style TargetType="Label" x:Key="FieldPrefix">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Texte d'une case a cocher : 14 / 20, #3C554B ; grise quand la case est desactivee -->
    <Style TargetType="Label" x:Key="CheckBoxText">
        <Setter Property="TextColor" Value="{StaticResource TextSoft}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.428571" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource TextDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label" x:Key="Caption">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="Label" x:Key="CaptionSmall">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Label" x:Key="ErrorText">
        <Setter Property="TextColor" Value="{StaticResource ErrorRed}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.384615" />
    </Style>

    <Style TargetType="Label" x:Key="HintText">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.384615" />
    </Style>

    <Style TargetType="Label" x:Key="CardTitle">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Label" x:Key="CardTitleSmall">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" x:Key="CardSubtitle">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Label" x:Key="MetaGreen">
        <Setter Property="TextColor" Value="{StaticResource PrimaryGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Label" x:Key="StatNumber">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="1.181818" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="StatLabel">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.333333" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="LinkText">
        <Setter Property="TextColor" Value="{StaticResource PrimaryGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="LinkTextBold">
        <Setter Property="TextColor" Value="{StaticResource PrimaryGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="LinkMuted">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="StateTitle">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="StateText">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.5" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="TabLabel">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="TabLabelActive" BasedOn="{StaticResource TabLabel}">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
    </Style>

    <Style TargetType="Label" x:Key="QuantityValue">
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="CharCounter">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>

    <!-- ===== Boutons ===== -->
    <!-- Bouton principal : degrade vert, hauteur 52, coins 26, texte blanc 16 semi-gras, ombre 0 8 16 vert a 25% -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,8" Radius="16" Opacity="0.25" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <!-- Etat "Actif" de la maquette : fond vert fonce -->
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource DeepGreenBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource DisabledButtonBrush}" />
                            <Setter Property="TextColor" Value="{StaticResource TextDisabled}" />
                            <Setter Property="Shadow" Value="{x:Null}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Bouton principal sur fond sombre (onboarding) : contour blanc a 25%, ombre 0 8 18 noir a 18% -->
    <Style TargetType="Button" x:Key="PrimaryButtonOnDark" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BorderColor" Value="{StaticResource OnboardingButtonBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowBlackBrush}" Offset="0,8" Radius="18" Opacity="0.18" />
        </Setter>
    </Style>

    <!-- Envoi en cours : bouton principal a 75% d'opacite, icone ronde fixe a gauche du texte -->
    <Style TargetType="Button" x:Key="PrimaryButtonBusy" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Opacity" Value="0.75" />
        <!-- Pas d'ombre pendant l'envoi (sur Android elle devient carree avec l'opacite) -->
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowGreenBrush}" Offset="0,0" Radius="0" Opacity="0" />
        </Setter>
    </Style>

    <!-- Variante hauteur 48, texte 15 (boutons des etats vides) -->
    <Style TargetType="Button" x:Key="PrimaryButtonCompact" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="28,0" />
    </Style>

    <!-- Bouton "Reessayer" de l'etat Pas de connexion : comme le compact, avec 32 de marge de chaque cote -->
    <Style TargetType="Button" x:Key="PrimaryButtonCompactWide" BasedOn="{StaticResource PrimaryButtonCompact}">
        <Setter Property="Padding" Value="32,0" />
    </Style>

    <!-- Deux boutons cote a cote (detail du besoin) : hauteur 52, texte 15 -->
    <Style TargetType="Button" x:Key="PrimaryButtonSplit" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Bouton secondaire : contour vert 1.5, fond transparent, texte vert fonce -->
    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{StaticResource GreenGradientStart}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="TextColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SoftGreenBackground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{StaticResource BorderDisabled}" />
                            <Setter Property="TextColor" Value="{StaticResource TextDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Etat erreur du bouton secondaire : contour et texte rouges -->
    <Style TargetType="Button" x:Key="SecondaryButtonError" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="BorderColor" Value="{StaticResource ErrorRed}" />
        <Setter Property="TextColor" Value="{StaticResource ErrorRed}" />
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButtonCompact" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="28,0" />
    </Style>

    <!-- Deux boutons cote a cote (detail du besoin) : hauteur 52, texte 15 -->
    <Style TargetType="Button" x:Key="SecondaryButtonSplit" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Bouton d'erreur (reessayer) : fond rose, contour rouge 1.5, texte rouge 15 semi-gras, hauteur 48 -->
    <Style TargetType="Button" x:Key="ErrorButton">
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorBackground}" />
        <Setter Property="BorderColor" Value="{StaticResource ErrorRed}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="TextColor" Value="{StaticResource ErrorRed}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="28,0" />
    </Style>

    <!-- Lien-bouton : texte vert 14 semi-gras, zone tactile 44 -->
    <Style TargetType="Button" x:Key="TextButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
